# Database URL (PostgreSQL)
# For local dev or Neon/Supabase cloud instance:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reportcard?schema=public"

# NextAuth secret (Generate with `openssl rand -base64 32`)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="development-secret-key-change-in-production-min-32-chars"

# Paystack (Optional in dev, test mode)
PAYSTACK_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxx"
